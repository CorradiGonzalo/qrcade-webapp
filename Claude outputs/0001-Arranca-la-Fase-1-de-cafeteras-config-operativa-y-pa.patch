diff --git a/supabase/migrations/0011_cafetera_config.sql b/supabase/migrations/0011_cafetera_config.sql
new file mode 100644
index 0000000..05b09ee
--- /dev/null
+++ b/supabase/migrations/0011_cafetera_config.sql
@@ -0,0 +1,46 @@
+-- QRcade — Config operativa de las cafeteras, manejada desde la app
+-- ─────────────────────────────────────────────────────────────
+-- El firmware original "ESP32 MPAY" cargaba TODO esto (incluido el
+-- Access Token de Mercado Pago) a mano, por placa, desde el portal
+-- cautivo de WiFiManager — 21 placas, 21 veces tipeando lo mismo a mano,
+-- sin poder tocar nada después sin ir físicamente hasta la máquina.
+--
+-- El firmware nuevo (kind='cafetera') sólo usa el portal cautivo para el
+-- WiFi. Todo lo demás se configura acá y se lo lleva el propio check-in
+-- (ver migración 0012 / resolverFirmwareUpdate en route.ts) — la placa
+-- lo cachea en su NVS, así que si el backend está caído sigue
+-- funcionando con el último valor que tenía.
+--
+-- El Access Token y el collector_id NO se guardan por placa: se
+-- REUSAN de profiles.mp_access_token / mp_user_id, la misma cuenta de MP
+-- que ya carga el dueño en "Mi cuenta" para las garras — una cafetera
+-- más no pide cargar nada de MP de nuevo.
+--
+-- mp_external_reference SÍ es por placa (es lo que distingue los pagos
+-- de una cafetera de los de otra dentro de la misma cuenta de MP) — se
+-- genera solo, determinístico a partir de la MAC, para no depender de
+-- que alguien lo tipee bien. OJO: para una placa que ya tenía pagos
+-- funcionando con el firmware viejo (un external_reference tipeado a
+-- mano, distinto), hay que recargar ese valor en la config de cobro de
+-- Mercado Pago de esa cafetera puntual para que siga matcheando.
+alter table public.devices
+  add column if not exists cafe_mp_external_reference text
+    generated always as ('CAFE' || regexp_replace(upper(mac), '[^A-Z0-9]', '', 'g')) stored,
+  add column if not exists cafe_pulso_min_us integer not null default 50000,
+  add column if not exists cafe_off_delay_ms integer not null default 500,
+  add column if not exists cafe_clean_pulse_ms integer not null default 3000,
+  add column if not exists cafe_heat_on_min integer not null default 20,
+  add column if not exists cafe_heat_off_min integer not null default 5,
+  add column if not exists cafe_clean_every_n_cycles integer not null default 50,
+  add column if not exists cafe_bt_reset_cmd text not null default 'RESET847200',
+  add column if not exists cafe_pulso_nivel_high boolean not null default true;
+
+comment on column public.devices.cafe_mp_external_reference is 'external_reference que esta cafetera usa para que MP distinga sus pagos de los de otra máquina de la misma cuenta. Generado solo a partir de la MAC — ver comentario de la migración.';
+comment on column public.devices.cafe_pulso_min_us is 'Duración mínima válida (µs) del pulso de "fin de ciclo" en GPIO27. Equivalente a pulseus del firmware original.';
+comment on column public.devices.cafe_off_delay_ms is 'Delay (ms) antes de apagar el relé de habilitación (GPIO25) tras el fin de ciclo. Equivalente a offdly.';
+comment on column public.devices.cafe_clean_pulse_ms is 'Duración (ms) de cada uno de los 2 pulsos del ciclo de limpieza automática. Equivalente a cleanpms.';
+comment on column public.devices.cafe_heat_on_min is 'Minutos que el calentador permanece encendido por ciclo. Equivalente a heaton.';
+comment on column public.devices.cafe_heat_off_min is 'Minutos que el calentador permanece apagado por ciclo. Equivalente a heatoff.';
+comment on column public.devices.cafe_clean_every_n_cycles is 'Cada cuántos créditos usados se dispara la limpieza automática. Equivalente a clncyc.';
+comment on column public.devices.cafe_bt_reset_cmd is 'Texto que hay que mandar por BLE (Nordic UART Service) para autorizar un reset de fábrica remoto. Equivalente a btrstcmd.';
+comment on column public.devices.cafe_pulso_nivel_high is 'Nivel activo esperado del pulso de entrada en GPIO27 (true=HIGH, false=LOW). Equivalente a pulslvl.';
diff --git a/supabase/migrations/0012_checkin_cafetera_config.sql b/supabase/migrations/0012_checkin_cafetera_config.sql
new file mode 100644
index 0000000..d2c0fc8
--- /dev/null
+++ b/supabase/migrations/0012_checkin_cafetera_config.sql
@@ -0,0 +1,138 @@
+-- QRcade — El check-in también le manda su config a una cafetera
+-- ─────────────────────────────────────────────────────────────
+-- Mismo mecanismo que ya usan comandos/combos/firmware (migración 0010):
+-- en el mismo viaje del check-in, si la placa es kind='cafetera' y está
+-- claimed, le mandamos también su config operativa (ver migración 0011)
+-- más el Access Token y collector_id de SU DUEÑO (reusado de
+-- profiles.mp_access_token/mp_user_id — la misma cuenta que ya carga
+-- para las garras, no hace falta cargar nada de MP de nuevo). La placa
+-- cachea esto en su NVS — si el backend está caído sigue con el último
+-- valor bueno que tenía.
+drop function if exists public.touch_device_checkin(text, text, integer);
+
+create function public.touch_device_checkin(
+  p_mac text,
+  p_firmware_version text,
+  p_wifi_rssi integer
+)
+returns table (
+  device public.devices,
+  previous_last_seen_at timestamptz,
+  pending_commands jsonb,
+  combos jsonb,
+  firmware_pending jsonb,
+  cafe_config jsonb
+)
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_previous timestamptz;
+  v_device public.devices;
+  v_commands jsonb;
+  v_combos jsonb;
+  v_firmware jsonb;
+  v_cafe jsonb;
+begin
+  select d.last_seen_at into v_previous
+  from public.devices d
+  where d.mac = p_mac;
+
+  if not found then
+    return;
+  end if;
+
+  update public.devices
+  set last_seen_at = now(),
+      firmware_version = p_firmware_version,
+      wifi_rssi = p_wifi_rssi
+  where mac = p_mac
+  returning public.devices.* into v_device;
+
+  if v_device.status = 'claimed' then
+    with acked as (
+      update public.device_commands
+      set acknowledged_at = now()
+      where device_id = v_device.id
+        and acknowledged_at is null
+      returning id, command, created_at
+    )
+    select coalesce(
+      jsonb_agg(jsonb_build_object('id', id, 'command', command) order by created_at),
+      '[]'::jsonb
+    )
+    into v_commands
+    from acked;
+
+    if v_device.mode = 'combo' then
+      select coalesce(
+        jsonb_agg(jsonb_build_object('monto', monto, 'fichas', fichas) order by monto),
+        '[]'::jsonb
+      )
+      into v_combos
+      from public.device_ficha_combos
+      where device_id = v_device.id;
+    else
+      v_combos := null;
+    end if;
+
+    select jsonb_build_object(
+      'status', dfs.status,
+      'updated_at', dfs.updated_at,
+      'firmware_version_id', dfs.firmware_version_id,
+      'version', fv.version,
+      'bin_url', fv.bin_url,
+      'changelog', fv.changelog,
+      'kind', fv.kind
+    )
+    into v_firmware
+    from public.device_firmware_status dfs
+    join public.firmware_versions fv on fv.id = dfs.firmware_version_id
+    where dfs.device_id = v_device.id
+      and dfs.status in ('accepted', 'downloading')
+    order by dfs.updated_at desc
+    limit 1;
+
+    if v_device.kind = 'cafetera' then
+      select jsonb_build_object(
+        'mp_access_token', p.mp_access_token,
+        'mp_collector_id', p.mp_user_id,
+        'mp_external_reference', v_device.cafe_mp_external_reference,
+        'pulso_min_us', v_device.cafe_pulso_min_us,
+        'off_delay_ms', v_device.cafe_off_delay_ms,
+        'clean_pulse_ms', v_device.cafe_clean_pulse_ms,
+        'heat_on_min', v_device.cafe_heat_on_min,
+        'heat_off_min', v_device.cafe_heat_off_min,
+        'clean_every_n_cycles', v_device.cafe_clean_every_n_cycles,
+        'bt_reset_cmd', v_device.cafe_bt_reset_cmd,
+        'pulso_nivel_high', v_device.cafe_pulso_nivel_high
+      )
+      into v_cafe
+      from public.profiles p
+      where p.id = v_device.owner_id;
+    else
+      v_cafe := null;
+    end if;
+  else
+    v_commands := '[]'::jsonb;
+    v_combos := null;
+    v_firmware := null;
+    v_cafe := null;
+  end if;
+
+  device := v_device;
+  previous_last_seen_at := v_previous;
+  pending_commands := v_commands;
+  combos := v_combos;
+  firmware_pending := v_firmware;
+  cafe_config := v_cafe;
+  return next;
+end;
+$$;
+
+comment on function public.touch_device_checkin(text, text, integer) is
+  'Check-in completo de una placa EXISTENTE en un solo viaje: actualiza last_seen_at/firmware_version/wifi_rssi, reconoce comandos pendientes, y trae combos + firmware pendiente + (si es cafetera) su config operativa y credenciales de MP de su dueño. No hace nada si la MAC no existe (la placa es nueva).';
+
+revoke all on function public.touch_device_checkin(text, text, integer) from public, anon, authenticated;
+grant execute on function public.touch_device_checkin(text, text, integer) to service_role;
diff --git a/supabase/migrations/0013_clean_cycle_command.sql b/supabase/migrations/0013_clean_cycle_command.sql
new file mode 100644
index 0000000..c4d4580
--- /dev/null
+++ b/supabase/migrations/0013_clean_cycle_command.sql
@@ -0,0 +1,13 @@
+-- QRcade — Botón de "limpieza manual" para cafeteras
+-- ─────────────────────────────────────────────────────────────
+-- El firmware original de la cafetera dispara el ciclo de limpieza solo
+-- (2 pulsos de GPIO25 separados por 20s) cada N créditos usados. El
+-- dueño pidió poder dispararlo también a mano desde el panel — mismo
+-- mecanismo que "Test" y "Reiniciar" (device_commands + check-in), sólo
+-- hace falta sumar el tipo de evento para loguearlo.
+alter table public.device_events
+  drop constraint if exists device_events_type_check;
+
+alter table public.device_events
+  add constraint device_events_type_check
+  check (type in ('wifi_reconnect', 'dispense_test', 'dispense_payment', 'restart_requested', 'firmware_update', 'clean_cycle'));

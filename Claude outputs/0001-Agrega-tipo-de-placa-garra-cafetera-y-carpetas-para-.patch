diff --git a/supabase/migrations/0008_device_kind.sql b/supabase/migrations/0008_device_kind.sql
new file mode 100644
index 0000000..91f72f6
--- /dev/null
+++ b/supabase/migrations/0008_device_kind.sql
@@ -0,0 +1,30 @@
+-- QRcade — Tipo de placa (garra vs. cafetera)
+-- ─────────────────────────────────────────────────────────────
+-- Vamos a sumar placas de cafetera (firmware "ESP32 MPAY", heredado y
+-- adaptado) a la misma flota que las garras. Son binarios TOTALMENTE
+-- distintos — pines, protocolo, lógica de negocio — así que hace falta
+-- una forma de que el backend jamás pueda ofrecerle a una placa el OTA
+-- del tipo equivocado. Eso sería catastrófico en una cafetera: el relé
+-- que habilita la botonera (GPIO25) dejaría de responder.
+--
+-- La placa declara su propio `kind` en el body del check-in (ver
+-- api/device/checkin/route.ts). Si no lo manda (firmware viejo de
+-- garra, que no conoce este campo), default 'garra' — compatibilidad
+-- hacia atrás total con las placas ya desplegadas.
+alter table public.devices
+  add column if not exists kind text not null default 'garra' check (kind in ('garra', 'cafetera'));
+
+comment on column public.devices.kind is 'Tipo de hardware/firmware: "garra" (máquina de peluches, flujo QR + fichas) o "cafetera" (ESP32 MPAY: relé habilitador de botonera + polling directo a MP). Lo declara la propia placa en su primer check-in.';
+
+create index if not exists devices_kind_idx on public.devices(kind);
+
+-- Cada versión de firmware publicada en el panel admin aplica a UN solo
+-- kind. uploadFirmwareAction sólo inserta device_firmware_status para
+-- placas del MISMO kind que la versión — nunca notifica (ni mucho menos
+-- instala) un firmware de garra en una cafetera o viceversa.
+alter table public.firmware_versions
+  add column if not exists kind text not null default 'garra' check (kind in ('garra', 'cafetera'));
+
+comment on column public.firmware_versions.kind is 'A qué tipo de placa aplica este .bin — ver devices.kind. Filtra a quién se le notifica/ofrece esta versión.';
+
+create index if not exists firmware_versions_kind_idx on public.firmware_versions(kind);
diff --git a/supabase/migrations/0009_device_folders.sql b/supabase/migrations/0009_device_folders.sql
new file mode 100644
index 0000000..095a7f5
--- /dev/null
+++ b/supabase/migrations/0009_device_folders.sql
@@ -0,0 +1,49 @@
+-- QRcade — Carpetas para organizar máquinas en el panel
+-- ─────────────────────────────────────────────────────────────
+-- Árbol de carpetas que cada dueño arma a su gusto (ej: "Dino Mall" >
+-- "Cafeteras" > placas sueltas). Puramente organizativo/visual — no
+-- cambia ningún permiso, la propiedad real de cada placa sigue siendo
+-- devices.owner_id.
+--
+-- El admin tiene SU PROPIO árbol aparte de los de cada usuario (filas
+-- con owner_id = su propio profiles.id), que sí puede agrupar placas de
+-- cualquier dueño — útil para organizar por ubicación física sin
+-- importar de quién es cada máquina.
+create table if not exists public.device_folders (
+  id uuid primary key default gen_random_uuid(),
+  owner_id uuid not null references public.profiles(id) on delete cascade,
+  parent_id uuid references public.device_folders(id) on delete cascade,
+  name text not null check (char_length(trim(name)) > 0),
+  created_at timestamptz not null default now()
+);
+
+create index if not exists device_folders_owner_id_idx on public.device_folders(owner_id);
+create index if not exists device_folders_parent_id_idx on public.device_folders(parent_id);
+
+comment on table public.device_folders is 'Árbol de carpetas por dueño (incluido el admin, con su propio árbol) para organizar máquinas en el panel. Visual únicamente.';
+
+-- Una máquina vive en, como mucho, una carpeta (como un archivo normal).
+-- null = sin carpeta, aparece "suelta" en la raíz.
+alter table public.devices
+  add column if not exists folder_id uuid references public.device_folders(id) on delete set null;
+
+create index if not exists devices_folder_id_idx on public.devices(folder_id);
+
+alter table public.device_folders enable row level security;
+
+create policy "device_folders: dueño o admin puede ver"
+  on public.device_folders for select
+  using (owner_id = auth.uid() or public.current_role_is_admin());
+
+create policy "device_folders: dueño o admin puede crear"
+  on public.device_folders for insert
+  with check (owner_id = auth.uid() or public.current_role_is_admin());
+
+create policy "device_folders: dueño o admin puede editar"
+  on public.device_folders for update
+  using (owner_id = auth.uid() or public.current_role_is_admin())
+  with check (owner_id = auth.uid() or public.current_role_is_admin());
+
+create policy "device_folders: dueño o admin puede borrar"
+  on public.device_folders for delete
+  using (owner_id = auth.uid() or public.current_role_is_admin());

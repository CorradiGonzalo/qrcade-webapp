       .from("devices")
-      .insert({ mac, claim_code: claimCode, status: "unclaimed", ...nowFields })
+      .insert({ mac, claim_code: claimCode, status: "unclaimed", kind, ...nowFields })
       .select("*")
       .single();
 
@@ -229,12 +237,12 @@ function normalizarVersion(v: string): string {
 
